---
import BaseLayout from '../../layouts/BaseLayout.astro';

const products = await Astro.glob('../../contents/products/*.md');

const processedProducts = products.map(product => ({
    ...product,
    url: `/shop/${product.file.split('/').pop()?.replace('.md', '')}`
}));
---

<BaseLayout>
    <main class="max-w-7xl mx-auto px-4 py-20">
        <h1 class="text-4xl font-bold mb-8">Shop</h1>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
            {processedProducts.map(product => (
                <div class="border rounded-lg overflow-hidden shadow-sm">
                    <img src={product.frontmatter.image} alt={product.frontmatter.title} 
                         class="w-full h-48 object-cover"/>
                    <div class="p-4">
                        <h2 class="text-xl font-bold mb-2">
                            <a href={product.url} class="hover:text-indigo-600">
                                {product.frontmatter.title}
                            </a>
                        </h2>
                        <p class="text-2xl font-bold text-indigo-600">
                            ${product.frontmatter.price}
                        </p>
                        <p class="mt-2 text-gray-600">
                            {product.frontmatter.description}
                        </p>
                        <button class="mt-4 w-full bg-indigo-600 text-white py-2 px-4 rounded hover:bg-indigo-700">
                            Add to Cart
                        </button>
                    </div>
                </div>
            ))}
        </div>
    </main>
</BaseLayout>

