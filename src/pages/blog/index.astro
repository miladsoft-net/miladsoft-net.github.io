---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';

const posts = await Astro.glob('../../contents/blog/*.md');

// Create URLs for posts manually since they're outside pages directory
const processedPosts = posts.map(post => ({
    ...post,
    url: `/blog/${post.file.split('/').pop()?.replace('.md', '')}`
}));
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout>
    <Header />
    <main class="max-w-4xl mx-auto px-4 py-20">
        <h1 class="text-4xl font-bold mb-8">Blog Posts</h1>
        <div class="space-y-8">
            {processedPosts.map(post => (
                <article class="border-b pb-8">
                    <h2 class="text-2xl font-bold mb-2">
                        <a href={post.url} class="hover:text-indigo-600">
                            {post.frontmatter.title}
                        </a>
                    </h2>
                    <time class="text-gray-600">
                        {new Date(post.frontmatter.date).toLocaleDateString()}
                    </time>
                    <p class="mt-2">{post.frontmatter.description}</p>
                </article>
            ))}
        </div>
    </main>
</BaseLayout>

<script>
  import Swup from 'swup';
  import SwupFadeTheme from '@swup/fade-theme';
  const swup = new Swup({
    plugins: [new SwupFadeTheme()],
    containers: ['#swup']
  });
</script>
