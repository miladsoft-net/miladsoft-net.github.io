---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';

export async function getStaticPaths() {
    const posts = await Astro.glob('../../contents/blog/*.md');
    
    return posts.map(post => ({
        params: {
            slug: post.file.split('/').pop()?.replace('.md', '')
        },
        props: { post }
    }));
}

const { post } = Astro.props;
---

<Layout>
    <Header />
    <article class="max-w-4xl mx-auto px-4 py-20">
        <h1 class="text-4xl font-bold mb-4">{post.frontmatter.title}</h1>
        <div class="text-gray-600 mb-8">
            <time>{new Date(post.frontmatter.date).toLocaleDateString()}</time>
        </div>
        <div class="prose max-w-none">
            <post.Content />
        </div>
    </article>
</Layout>
