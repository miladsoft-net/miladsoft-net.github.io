---
import MainGridLayout from '../../layouts/MainGridLayout.astro'
import CartView from '../../components/CartView.svelte'
---

<MainGridLayout title="Shopping Cart">
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4"></div>
        <div class="card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full">
            <div class="relative onload-animation">
                <div class="transition w-full block font-bold mb-6
                    text-3xl md:text-[2.25rem]/[2.75rem]
                    text-black/90 dark:text-white/90
                    md:before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
                    before:absolute before:top-[0.75rem] before:left-[-1.125rem]">
                    Shopping Cart
                </div>
            </div>
            <CartView client:load />
        </div>
    </div>
</MainGridLayout>
