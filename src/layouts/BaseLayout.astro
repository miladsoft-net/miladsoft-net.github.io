---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "Astro Basics" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen swup-transition-main">
    <div id="swup" class="transition-slide">
      <slot />
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  .transition-slide {
    transform: translateX(100%);
    transition: transform 0.4s ease;
  }

  .swup-transition-main {
    transform: translateX(0);
  }

  .swup-transition-main.is-animating {
    transform: translateX(-100%);
  }
</style>
