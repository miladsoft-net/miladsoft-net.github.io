<header class="bg-white shadow-sm fixed w-full top-0 z-50">
    <nav class="container mx-auto px-4 py-3 flex justify-between items-center">
        <a href="/" class="text-2xl font-bold text-indigo-600">Logo</a>
        <ul class="flex space-x-6">
            <li><a href="/" class="text-gray-600 hover:text-indigo-600">Home</a></li>
            <li><a href="/shop" class="text-gray-600 hover:text-indigo-600">Shop</a></li>
            <li><a href="/blog" class="text-gray-600 hover:text-indigo-600">Blog</a></li>
        </ul>
    </nav>
</header>

<style>
  nav ul {
    list-style: none;
    padding: 0;
  }

  nav ul li {
    display: inline;
    margin-right: 10px;
  }

  nav ul li a {
    text-decoration: none;
    color: inherit;
  }

  @media (max-width: 640px) {
    nav ul {
      flex-direction: column;
      align-items: center;
    }

    nav ul li {
      display: block;
      margin: 10px 0;
    }
  }
</style>
